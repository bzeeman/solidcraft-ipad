<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The iPad app bundle's Info.plist (packaging/ios/bundle.sh fills @VERSION@, @BUILD@, @MIN_OS@
     and, for the simulator or a real iPad, @PLATFORM@ and @PLATFORM_NAME@; on a Mac it also adds
     the icon and the DT* keys that name the Xcode and SDK of the build, which Apple's upload
     checks read). iPad only; UILaunchScreen makes iPadOS give the app the whole screen instead
     of a letterboxed compatibility size. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>solidcraft-ios</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.bzeeman.solidcraft-ipad</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>SolidCraft</string>
  <key>CFBundleDisplayName</key>
  <string>SolidCraft</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@BUILD@</string>
  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>@PLATFORM@</string>
  </array>
  <key>DTPlatformName</key>
  <string>@PLATFORM_NAME@</string>
  <!-- The app's only encryption is HTTPS (rustls) for the agent chat's model requests: standard
       encryption for an ordinary purpose, which Apple exempts. That is what this key states, and
       without it TestFlight holds every build until the question is answered by hand. Look again
       when the iPad app gains any other encryption. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>MinimumOSVersion</key>
  <string>@MIN_OS@</string>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>UIDeviceFamily</key>
  <array>
    <integer>2</integer>
  </array>
  <key>UILaunchScreen</key>
  <dict/>
  <!-- The app's Documents folder shows in the Files app as On My iPad > SolidCraft, so designs
       saved there can be found, copied in and shared without the app. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- The UIScene life cycle, which apps built with the iOS 27 SDK must have: one scene, made by
       the vendored winit's scene delegate (vendor/winit/src/platform_impl/ios/scene.rs). One
       only: the app draws one window, and a second scene would stay empty. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key>
          <string>Default</string>
          <key>UISceneDelegateClassName</key>
          <string>WinitSceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <!-- Designs open in SolidCraft from the Files app (a tap, or "Open in"), in place: the scene
       delegate hands the file to the shell, which opens it as a picked one. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>SolidCraft design</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array><string>io.tangencylabs.solidcraft.design</string></array>
    </dict>
  </array>
  <!-- The design type, as the macOS app declares it (assets/platforms/macos/Info.plist.in), so the
       document picker and the Files app know .sc files by name. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.tangencylabs.solidcraft.design</string>
      <key>UTTypeDescription</key>
      <string>SolidCraft design</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.content</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>sc</string><string>solidcraft</string><string>solvecraft</string></array>
      </dict>
    </dict>
  </array>
  <!-- The agent chat's model can be on a computer on the same network (LM Studio or Ollama on a
       Mac): iPadOS asks before an app reaches the local network, with this reason. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>SolidCraft's assistant talks to a language model running on a computer on your network.</string>
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
